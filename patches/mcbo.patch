+# This program is free software; you can redistribute it and/or modify it under
+# the terms of the MIT license.
+
+# This program is distributed in the hope that it will be useful, but WITHOUT ANY
+# WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A
+# PARTICULAR PURPOSE. See the MIT License for more details.
+
+r"""
+Acquisition optimizers for Fast BO on categorical inputs (``OneHotBLRModel``).
+
+A linear function of one-hot features separates over the variables, so we can minimize
+it exactly by taking the best category of each variable. In a Hamming trust region of
+radius r, only the r variables with the largest gain change. TS minimizes one such
+function. For LCB and EI we linearize the posterior std and repeat (majorize-minimize).
+Everything is minimized, as in MCBO. phi are the one-hot features (M of them).
+"""
+
+import math
+from typing import Callable, Dict, List, Optional, Union
+
+import numpy as np
+import torch
+
+from mcbo.acq_funcs.acq_base import AcqBase
+from mcbo.acq_funcs.ei import EI
+from mcbo.acq_funcs.lcb import LCB
+from mcbo.acq_optimizers.acq_optimizer_base import AcqOptimizerBase
+from mcbo.models import ModelBase
+from mcbo.models.linear_reagression.onehot_blr import OneHotBLRModel
+from mcbo.search_space import SearchSpace
+from mcbo.trust_region import TrManagerBase
+from mcbo.utils.plot_resource_utils import COLORS_SNS_10, get_color
+
+# Number of random points to try when all single flips were already observed
+N_FALLBACK = 64
+
+
+def features(cats: np.ndarray, offsets: List[int], width: int, dtype, device) -> torch.Tensor:
+    """ One-hot features of category indices. """
+    phi = torch.zeros((len(cats), width), dtype=dtype, device=device)
+    indices = torch.as_tensor(np.asarray(offsets[:-1])[None, :] + cats, device=device)
+    phi.scatter_(1, indices, 1.0)
+    return phi
+
+
+def linear_minima(weights: torch.Tensor, centre: np.ndarray, offsets: List[int], radius: int) -> np.ndarray:
+    """ Minimize ``weights @ phi`` exactly over the Hamming ball, for each row of weights. """
+    best, gains = [], []
+    for j in range(len(centre)):
+        block = weights[:, offsets[j]:offsets[j + 1]]
+        choice = block.argmin(1)
+        best.append(choice)
+        gains.append(block[:, int(centre[j])] - block.gather(1, choice[:, None]).squeeze(1))
+    cats = torch.stack(best, 1).cpu().numpy()
+    if radius >= len(centre):
+        return cats
+    result = np.broadcast_to(centre, cats.shape).copy()
+    if radius > 0:
+        order = np.argsort(-torch.stack(gains, 1).cpu().numpy(), axis=1)[:, :radius]
+        rows = np.arange(len(cats))[:, None]
+        result[rows, order] = cats[rows, order]
+    return result
+
+
+def inverse_mills(gamma: torch.Tensor) -> torch.Tensor:
+    """ phi(gamma) / Phi(gamma), stable for very negative gamma. """
+    negative = math.sqrt(2 / math.pi) / torch.special.erfcx(
+        -gamma.clamp_max(0) / math.sqrt(2)
+    )
+    positive = torch.exp(-0.5 * gamma.square()) / (
+        math.sqrt(2 * math.pi) * 0.5 * torch.erfc(-gamma / math.sqrt(2))
+    ).clamp_min(1e-300)
+    return torch.where(gamma < 0, negative, positive)
+
+
+def in_region(z: List[int], centre: List[int], radius: int) -> bool:
+    """ Check whether ``z`` is within Hamming distance ``radius`` of ``centre``. """
+    return sum(int(a) != int(b) for a, b in zip(z, centre)) <= radius
+
+
+def single_flips(cat: List[int], n_cats: List[int], observed: set, centre: List[int],
+                 radius: int) -> List[List[int]]:
+    """ Unobserved points in the trust region that differ from ``cat`` in one variable. """
+    flips = []
+    for j in range(len(cat)):
+        for c in range(n_cats[j]):
+            if c != cat[j]:
+                z = list(cat)
+                z[j] = c
+                if tuple(z) not in observed and in_region(z, centre, radius):
+                    flips.append(z)
+    return flips
+
+
+def random_draws(cat: List[int], n_cats: List[int], radius: int, observed: set,
+                 rng: np.random.Generator, centre: List[int], min_changes: int = 2) -> List[List[int]]:
+    """ Up to ``N_FALLBACK`` random unobserved points in the trust region, each changing
+    ``min_changes`` to ``radius`` variables of ``cat``. """
+    n_nom = len(cat)
+    pool, tries = [], 0
+    r_max = max(1, min(int(radius), n_nom))
+    while radius > 0 and len(pool) < N_FALLBACK and tries < 20 * N_FALLBACK:
+        tries += 1
+        z = list(cat)
+        k = int(rng.integers(min_changes, r_max + 1)) if r_max >= min_changes else 1
+        for j in np.atleast_1d(rng.choice(n_nom, size=k, replace=False)):
+            z[int(j)] = int(rng.integers(0, n_cats[int(j)]))
+        if tuple(z) not in observed and in_region(z, centre, radius):
+            pool.append(z)
+    return pool
+
+
+class _FastBOAcqOptimizerBase(AcqOptimizerBase):
+    """ Common setup. Only nominal inputs, no input constraints. """
+
+    def __init__(self,
+                 search_space: SearchSpace,
+                 input_constraints: Optional[List[Callable[[Dict], bool]]],
+                 obj_dims: Union[List[int], np.ndarray, None],
+                 out_constr_dims: Union[List[int], np.ndarray, None],
+                 out_upper_constr_vals: Optional[torch.Tensor],
+                 dtype: torch.dtype = torch.float64,
+                 ):
+        assert search_space.num_nominal == search_space.num_params, \
+            "Fast BO only supports purely nominal (categorical) search spaces."
+        assert not input_constraints, "Fast BO does not support input constraints."
+        super().__init__(
+            search_space=search_space,
+            dtype=dtype,
+            input_constraints=input_constraints,
+            obj_dims=obj_dims,
+            out_constr_dims=out_constr_dims,
+            out_upper_constr_vals=out_upper_constr_vals,
+        )
+
+    @staticmethod
+    def observed_set(x_observed: torch.Tensor, nominal_dims: List[int]) -> set:
+        return {tuple(r) for r in x_observed[:, nominal_dims].round().long().cpu().tolist()}
+
+
+class FastBOMMAcqOptimizer(_FastBOAcqOptimizerBase):
+    r"""
+    LCB and EI, minimized by majorize-minimize (MM) from random starts.
+
+    Each MM step replaces the std by its tangent, which gives the linear objective
+    ``m - lam * (S_N phi_0) / s_0`` (``lam = beta`` for LCB, the inverse Mills ratio for
+    EI), and minimizes it exactly. We return the best result under the exact acquisition
+    that has not been observed yet. If all of them have been, we fall back to single flips
+    of the best one, then random points near it, then random points in the trust region.
+    """
+
+    color_1: str = get_color(ind=6, color_palette=COLORS_SNS_10)
+
+    @staticmethod
+    def get_color_1() -> str:
+        return FastBOMMAcqOptimizer.color_1
+
+    @property
+    def name(self) -> str:
+        return "Fast BO (MM)"
+
+    def __init__(self,
+                 search_space: SearchSpace,
+                 input_constraints: Optional[List[Callable[[Dict], bool]]],
+                 obj_dims: Union[List[int], np.ndarray, None],
+                 out_constr_dims: Union[List[int], np.ndarray, None],
+                 out_upper_constr_vals: Optional[torch.Tensor],
+                 n_restarts: int = 10,
+                 mm_steps: int = 10,
+                 dtype: torch.dtype = torch.float64,
+                 ):
+        super().__init__(search_space, input_constraints, obj_dims, out_constr_dims,
+                         out_upper_constr_vals, dtype)
+        self.n_restarts = n_restarts
+        self.mm_steps = mm_steps
+        self.std_guard = 1e-8
+
+    def mm(self, starts: np.ndarray, centre: np.ndarray, offsets: List[int], radius: int,
+           model: OneHotBLRModel, best_y: Optional[torch.Tensor], beta: Optional[float]) -> List[np.ndarray]:
+        """ Run MM on all starts at once. """
+        cats = np.asarray(starts).copy()
+        mean_w, vectors, denom = model.m_n, model.eig_vecs, model.denom
+        if beta is None:
+            best = float((best_y - model.y_mean) / model.y_std)
+        # Same variance floor as EI.evaluate (in original units)
+        floor = 1e-9 / float(model.y_std.square())
+        noise = float(1 / model.beta)
+        phi = features(cats, offsets, len(mean_w), mean_w.dtype, mean_w.device)
+        for _ in range(self.mm_steps):
+            sp = (phi @ vectors / denom) @ vectors.T  # S_N phi
+            variance = (phi * sp).sum(1).clamp_min(0) + noise
+            std = variance.clamp_min(floor).sqrt()
+            lam = (inverse_mills((best - phi @ mean_w) / std) if beta is None
+                   else torch.full_like(std, beta))
+            coef = torch.where((variance >= floor) & (std > self.std_guard), lam / std, 0)
+            weights = mean_w - coef[:, None] * sp
+            new = linear_minima(weights, centre, offsets, radius)
+            new_phi = features(new, offsets, len(mean_w), mean_w.dtype, mean_w.device)
+            accept = (weights * (new_phi - phi)).sum(1) <= 0
+            new = np.where(accept.cpu().numpy()[:, None], new, cats)
+            new_phi = torch.where(accept[:, None], new_phi, phi)
+            done = np.array_equal(new, cats)
+            cats, phi = new, new_phi
+            if done:
+                break
+        return list(cats)
+
+    def optimize(self,
+                 x: torch.Tensor,
+                 n_suggestions: int,
+                 x_observed: torch.Tensor,
+                 model: ModelBase,
+                 acq_func: AcqBase,
+                 acq_evaluate_kwargs: dict,
+                 tr_manager: Optional[TrManagerBase],
+                 **kwargs
+                 ) -> torch.Tensor:
+        assert n_suggestions == 1, "FastBOMMAcqOptimizer supports n_suggestions == 1."
+        assert isinstance(model, OneHotBLRModel), \
+            f"FastBOMMAcqOptimizer requires a OneHotBLRModel, got {type(model)}."
+        is_lcb = isinstance(acq_func, LCB)
+        assert is_lcb or (isinstance(acq_func, EI) and not acq_func.augmented_ei), \
+            "FastBOMMAcqOptimizer requires LCB or ordinary Gaussian EI."
+
+        device, dtype = model.device, model.dtype
+        nominal_dims = model.nominal_dims
+        offsets = model.block_offsets
+        n_nom = len(nominal_dims)
+        n_cats = np.array(model.n_cats_per_dim)
+
+        # Trust-region centre and Hamming radius
+        centre = x.clone().view(-1).to(device=device, dtype=dtype)
+        centre_cat = np.array([int(centre[d].round().item()) for d in nominal_dims])
+        radius = int(tr_manager.get_nominal_radius()) if tr_manager is not None else n_nom
+        radius = max(0, min(radius, n_nom))
+
+        # Random starts: set `radius` random variables of the centre to random categories.
+        # Seeded from the global numpy RNG.
+        rng = np.random.default_rng(np.random.randint(0, 2 ** 32))
+        starts = []
+        for _ in range(self.n_restarts):
+            cat0 = centre_cat.copy()
+            if radius > 0:
+                idx = rng.choice(n_nom, size=radius, replace=False)
+                cat0[idx] = rng.integers(0, n_cats[idx])
+            starts.append(cat0)
+        candidates = self.mm(starts, centre_cat, offsets, radius, model,
+                             best_y=None if is_lcb else acq_evaluate_kwargs["best_y"],
+                             beta=float(acq_func.beta) if is_lcb else None)
+
+        # Score the distinct candidates with the exact acquisition
+        cats = list({tuple(c): c for c in candidates}.values())
+        x_cand = centre.view(1, -1).repeat(len(cats), 1)
+        for i, c in enumerate(cats):
+            for j, d in enumerate(nominal_dims):
+                x_cand[i, d] = float(c[j])
+        acq_vals = acq_func(x=x_cand, model=model, **acq_evaluate_kwargs).flatten()
+
+        # Return the best candidate we haven't evaluated yet (the tasks are deterministic)
+        observed = self.observed_set(x_observed.to(device=device, dtype=dtype), nominal_dims)
+        for i in torch.argsort(acq_vals).tolist():
+            if tuple(x_cand[i][nominal_dims].round().long().cpu().tolist()) not in observed:
+                return x_cand[i].view(1, -1).to(self.dtype)
+
+        # All candidates already observed: fall back to single flips of the best one, then
+        # random points near it, then random points anywhere in the trust region
+        best_i = min(range(len(cats)), key=lambda i: float(acq_vals[i]))
+        base = x_cand[best_i]
+        base_cat = [int(round(float(base[d]))) for d in nominal_dims]
+        centre_list = [int(c) for c in centre_cat]
+        for make_pool in (
+                lambda: single_flips(base_cat, list(n_cats), observed, centre_list, radius),
+                lambda: random_draws(base_cat, list(n_cats), radius, observed, rng, centre_list),
+                lambda: random_draws(centre_list, list(n_cats), radius, observed, rng, centre_list,
+                                     min_changes=1)):
+            pool = make_pool()
+            if pool:
+                x_pool = base.view(1, -1).repeat(len(pool), 1)
+                for i, c in enumerate(pool):
+                    for j, d in enumerate(nominal_dims):
+                        x_pool[i, d] = float(c[j])
+                values = acq_func(x=x_pool, model=model, **acq_evaluate_kwargs).flatten()
+                return x_pool[int(torch.argmin(values).item())].view(1, -1).to(self.dtype)
+        return base.view(1, -1).to(self.dtype)
+
+
+class FastBOTSAcqOptimizer(_FastBOAcqOptimizerBase):
+    r"""
+    Thompson sampling, minimized exactly.
+
+    Draws one posterior weight sample and minimizes it over the trust region. If the
+    result was already observed, uses the same fallback as FastBOMMAcqOptimizer.
+    """
+
+    color_1: str = get_color(ind=5, color_palette=COLORS_SNS_10)
+
+    @staticmethod
+    def get_color_1() -> str:
+        return FastBOTSAcqOptimizer.color_1
+
+    @property
+    def name(self) -> str:
+        return "Fast BO (TS)"
+
+    def optimize(self,
+                 x: torch.Tensor,
+                 n_suggestions: int,
+                 x_observed: torch.Tensor,
+                 model: ModelBase,
+                 acq_func: AcqBase,
+                 acq_evaluate_kwargs: dict,
+                 tr_manager: Optional[TrManagerBase],
+                 **kwargs
+                 ) -> torch.Tensor:
+        assert n_suggestions == 1, "FastBOTSAcqOptimizer supports n_suggestions == 1."
+        assert isinstance(model, OneHotBLRModel), \
+            f"FastBOTSAcqOptimizer requires a OneHotBLRModel, got {type(model)}."
+
+        nominal_dims = model.nominal_dims
+        offsets = model.block_offsets
+        n_cats = list(model.n_cats_per_dim)
+
+        # Trust-region centre and Hamming radius
+        centre = x.clone().view(-1).to(device=model.device, dtype=model.dtype)
+        centre_cat = np.array([int(centre[d].round().item()) for d in nominal_dims])
+        radius = int(tr_manager.get_nominal_radius()) if tr_manager is not None else len(nominal_dims)
+
+        w = model.sample_weights(n_samples=1)  # (1, D), standardized
+        observed = self.observed_set(x_observed.to(model.device), nominal_dims)
+        rng = np.random.default_rng(np.random.randint(0, 2 ** 32))
+
+        def sampled_value(cat: List[int]) -> float:
+            return float(sum(float(w[0, offsets[j] + int(c)]) for j, c in enumerate(cat)))
+
+        chosen = [int(c) for c in linear_minima(w, centre_cat, offsets, radius)[0]]
+        if tuple(chosen) in observed:
+            # Already observed: same fallback as in FastBOMMAcqOptimizer
+            centre_list = [int(c) for c in centre_cat]
+            for pool in (lambda: single_flips(chosen, n_cats, observed, centre_list, radius),
+                         lambda: random_draws(chosen, n_cats, radius, observed, rng, centre_list),
+                         lambda: random_draws(centre_list, n_cats, radius, observed, rng,
+                                              centre_list, min_changes=1)):
+                candidates = pool()
+                if candidates:
+                    chosen = min(candidates, key=sampled_value)
+                    break
+
+        x_next = centre.clone()
+        for j, d in enumerate(nominal_dims):
+            x_next[d] = chosen[j]
+        return x_next.view(1, -1).to(self.dtype)
