+# This program is free software; you can redistribute it and/or modify it under
+# the terms of the MIT license.
+
+# This program is distributed in the hope that it will be useful, but WITHOUT ANY
+# WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A
+# PARTICULAR PURPOSE. See the MIT License for more details.
+
+from typing import List, Optional
+
+import torch
+
+from mcbo.models.model_base import ModelBase
+from mcbo.search_space import SearchSpace
+
+
+class OneHotBLRModel(ModelBase):
+    r"""
+    Bayesian linear regression on one-hot features, fit in closed form.
+
+    Equivalent to a GP with the overlap kernel (without ARD):
+
+        prior:       w ~ N(0, alpha^{-1} I)
+        likelihood:  t ~ N(Phi w, beta^{-1} I)
+
+    alpha and beta are fit with Bishop's evidence maximization (PRML 3.5), reusing one
+    eigendecomposition of ``Phi^T Phi``. D is the number of one-hot features.
+
+    We use Bishop's notation. In the paper, alpha is tau, 1/beta is sigma^2, Phi is H and
+    D is M (the paper's D is the number of variables).
+    """
+
+    supports_cuda = True
+    support_grad = False
+    support_ts = True
+    support_multi_output = False
+    support_warm_start = True
+
+    @property
+    def name(self) -> str:
+        return "BLR (OL)"
+
+    def __init__(
+            self,
+            search_space: SearchSpace,
+            num_out: int = 1,
+            noise_lb: float = 1e-8,
+            max_iter: int = 100,
+            tol: float = 1e-5,
+            dtype: torch.dtype = torch.float64,
+            device: torch.device = torch.device("cpu"),
+    ):
+        super(OneHotBLRModel, self).__init__(search_space=search_space, num_out=num_out, dtype=dtype, device=device)
+        assert self.num_out == 1, "OneHotBLRModel only supports single-output regression."
+        assert len(self.nominal_dims) > 0, "OneHotBLRModel expects nominal (categorical) dimensions."
+
+        self.noise_lb = noise_lb
+        self.max_iter = max_iter
+        self.tol = tol
+
+        # Number of categories per variable
+        self.n_cats_per_dim = [
+            len(self.search_space.params[name].categories) for name in self.search_space.nominal_names
+        ]
+        # Start of each variable's one-hot block in Phi
+        self.block_offsets = [0]
+        for n_cat in self.n_cats_per_dim:
+            self.block_offsets.append(self.block_offsets[-1] + n_cat)
+
+        # Set in fit()
+        self.alpha: Optional[torch.Tensor] = None  # prior precision
+        self.beta: Optional[torch.Tensor] = None  # noise precision (1 / noise_var)
+        self.m_n: Optional[torch.Tensor] = None  # posterior mean weights, shape (D,)
+        self.eig_vecs: Optional[torch.Tensor] = None  # eigenvectors of Phi^T Phi, shape (D, D)
+        self.denom: Optional[torch.Tensor] = None  # alpha + beta * eigenvalues, shape (D,)
+
+    def y_to_fit_y(self, y: torch.Tensor) -> torch.Tensor:
+        return (y - self.y_mean.to(y)) / self.y_std.to(y)
+
+    def fit_y_to_y(self, fit_y: torch.Tensor) -> torch.Tensor:
+        return fit_y * self.y_std.to(fit_y) + self.y_mean.to(fit_y)
+
+    def _featurize(self, x: torch.Tensor) -> torch.Tensor:
+        """ One-hot encode the nominal dimensions of `x` -> Phi of shape (N, D). """
+        x = x.to(dtype=self.dtype, device=self.device)
+        blocks = []
+        for j, dim in enumerate(self.nominal_dims):
+            n_cat = self.n_cats_per_dim[j]
+            idx = x[:, dim].round().long().clamp_(0, n_cat - 1)
+            oh = torch.zeros(x.shape[0], n_cat, dtype=self.dtype, device=self.device)
+            oh.scatter_(1, idx.unsqueeze(1), 1.0)
+            blocks.append(oh)
+        return torch.cat(blocks, dim=1)
+
+    def fit(self, x: torch.Tensor, y: torch.Tensor, **kwargs) -> List[float]:
+        assert x.ndim == 2
+        assert y.ndim == 2, y.shape
+        assert x.shape[0] == y.shape[0]
+        assert y.shape[1] == self.num_out, (y.shape, self.num_out)
+
+        self.x = x.to(dtype=self.dtype, device=self.device)
+        self._y = y.to(dtype=self.dtype, device=self.device)
+        self.fit_y = self.y_to_fit_y(y=self._y)
+
+        phi = self._featurize(self.x)  # (N, D)
+        t = self.fit_y.squeeze(-1)  # (N,)
+        n = phi.shape[0]
+
+        # Eigendecomposition of Phi^T Phi (D x D), reused for every evidence update
+        a_mat = phi.transpose(-1, -2) @ phi  # (D, D)
+        eigvals, eigvecs = torch.linalg.eigh(a_mat)  # ascending eigvals (D,), eigvecs (D, D)
+        eigvals = eigvals.clamp_(min=0.0)
+        b = phi.transpose(-1, -2) @ t  # (D,)
+        c = eigvecs.transpose(-1, -2) @ b  # projection of b into eigenbasis, (D,)
+        tt = torch.dot(t, t)  # ||t||^2
+
+        beta_max = torch.tensor(1.0 / self.noise_lb, dtype=self.dtype, device=self.device)
+
+        # Evidence maximization for (alpha, beta), same iteration as sklearn's BayesianRidge
+        alpha = torch.tensor(1.0, dtype=self.dtype, device=self.device)
+        beta = torch.tensor(1.0, dtype=self.dtype, device=self.device)
+        for _ in range(self.max_iter):
+            denom = alpha + beta * eigvals  # (D,)
+            p = beta * c / denom  # eigenbasis coeffs of posterior mean (m_N = V p)
+            m_sq = torch.dot(p, p)  # m_N^T m_N
+            gamma = (beta * eigvals / denom).sum()  # effective number of parameters
+            rss = (tt - 2.0 * torch.dot(p, c) + torch.dot(eigvals * p, p)).clamp_(min=1e-12)
+
+            new_alpha = (gamma / m_sq.clamp_(min=1e-12))
+            new_beta = ((n - gamma).clamp_(min=1e-6) / rss).clamp_(max=beta_max)
+
+            if (torch.abs(new_alpha - alpha) <= self.tol * alpha
+                    and torch.abs(new_beta - beta) <= self.tol * beta):
+                alpha, beta = new_alpha, new_beta
+                break
+            alpha, beta = new_alpha, new_beta
+
+        denom = alpha + beta * eigvals
+        p = beta * c / denom
+        self.alpha = alpha
+        self.beta = beta
+        self.eig_vecs = eigvecs
+        self.denom = denom
+        self.m_n = eigvecs @ p  # posterior mean weights, (D,)
+
+        return []
+
+    def predict(self, x: torch.Tensor, **kwargs) -> (torch.Tensor, torch.Tensor):
+        """ Predictive mean and variance of y (the variance includes the noise). """
+        phi = self._featurize(x)  # (M, D)
+        mu = phi @ self.m_n  # (M,) standardized mean
+        z = phi @ self.eig_vecs  # (M, D)
+        var = (z * z / self.denom).sum(dim=1)  # phi^T S_N phi, (M,)
+        var = var + 1.0 / self.beta
+
+        mu = mu.reshape(-1, self.num_out)
+        var = var.reshape(-1, self.num_out)
+
+        mu = self.fit_y_to_y(fit_y=mu)
+        var = var * self.y_std.to(var) ** 2
+        return mu, var.clamp(min=torch.finfo(var.dtype).eps)
+
+    def sample_weights(self, n_samples: int = 1) -> torch.Tensor:
+        r"""
+        Sample weights from the posterior N(m_N, S_N) (standardized targets). Returns shape
+        (n_samples, D). With S_N = V diag(1/denom) V^T, w = m_N + V (z / sqrt(denom)).
+        """
+        assert self.m_n is not None, "Model must be fit before sampling weights."
+        d = self.m_n.shape[0]
+        z = torch.randn(n_samples, d, dtype=self.dtype, device=self.device)
+        u = z / self.denom.sqrt()  # (n_samples, D)
+        return self.m_n.unsqueeze(0) + u @ self.eig_vecs.transpose(-1, -2)
+
+    @property
+    def noise(self) -> torch.Tensor:
+        return ((1.0 / self.beta) * self.y_std ** 2).view(self.num_out).detach()
+
+    def to(self, device: Optional[torch.device] = None, dtype: Optional[torch.dtype] = None) -> "OneHotBLRModel":
+        self.device = device
+        self.dtype = dtype
+        for attr in ("alpha", "beta", "m_n", "eig_vecs", "denom", "x", "_y", "fit_y"):
+            val = getattr(self, attr, None)
+            if isinstance(val, torch.Tensor):
+                setattr(self, attr, val.to(device=device, dtype=dtype))
+        return self
